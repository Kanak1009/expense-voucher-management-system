# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_vouchers

# Auth (use a long random string in real deployments)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_vouchers_test
